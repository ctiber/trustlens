# p3 ON — HTTPS with mandatory client certificate (only the gateway holds one)
SERVER_SSL_ENABLED=true
SERVER_SSL_KEY_STORE=/certs/keystore.p12
SERVER_SSL_KEY_STORE_PASSWORD=changeit
SERVER_SSL_KEY_STORE_TYPE=PKCS12
SERVER_SSL_TRUST_STORE=/certs/truststore.p12
SERVER_SSL_TRUST_STORE_PASSWORD=changeit
SERVER_SSL_TRUST_STORE_TYPE=PKCS12
SERVER_SSL_CLIENT_AUTH=need
