# p3 ON — Kafka clients authenticate to the broker SSL listener (Broker-mTLS)
SPRING_KAFKA_BOOTSTRAP_SERVERS=kafka:9093
SPRING_KAFKA_SECURITY_PROTOCOL=SSL
SPRING_KAFKA_SSL_KEY_STORE_LOCATION=file:/certs/keystore.p12
SPRING_KAFKA_SSL_KEY_STORE_PASSWORD=changeit
SPRING_KAFKA_SSL_KEY_STORE_TYPE=PKCS12
SPRING_KAFKA_SSL_KEY_PASSWORD=changeit
SPRING_KAFKA_SSL_TRUST_STORE_LOCATION=file:/certs/truststore.p12
SPRING_KAFKA_SSL_TRUST_STORE_PASSWORD=changeit
SPRING_KAFKA_SSL_TRUST_STORE_TYPE=PKCS12
