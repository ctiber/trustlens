# p3 ON — only a mutually-authenticated SSL listener is reachable from the
# network; the plaintext listener is bound to the broker's loopback for
# inter-broker traffic only. An internal service without a CA-signed client
# certificate cannot publish to the topics (Scenario A).
KAFKA_LISTENERS=SSL://0.0.0.0:9093,INTERNAL://127.0.0.1:29092
KAFKA_ADVERTISED_LISTENERS=SSL://kafka:9093,INTERNAL://127.0.0.1:29092
KAFKA_LISTENER_SECURITY_PROTOCOL_MAP=SSL:SSL,INTERNAL:PLAINTEXT
KAFKA_INTER_BROKER_LISTENER_NAME=INTERNAL
KAFKA_SSL_KEYSTORE_FILENAME=keystore.p12
KAFKA_SSL_KEYSTORE_TYPE=PKCS12
KAFKA_SSL_KEYSTORE_CREDENTIALS=keystore_creds
KAFKA_SSL_KEY_CREDENTIALS=key_creds
KAFKA_SSL_TRUSTSTORE_FILENAME=truststore.p12
KAFKA_SSL_TRUSTSTORE_TYPE=PKCS12
KAFKA_SSL_TRUSTSTORE_CREDENTIALS=truststore_creds
KAFKA_SSL_CLIENT_AUTH=required
