# v2-mtls-sr — s=(1,1,1,1,0) V2 + mTLS + Vault secret rotation
ZT_AC4A=true
ZT_MTLS=true
ZT_MTLS_MODE=on
ZT_SR=true
ZT_SR_LEVEL=1.0
ZT_SR_BASE_PERIOD_S=60
ZT_RA=false
ZT_RA_LEVEL=1.0
ZT_PROFILES=sr

VAULT_ADDR=http://vault:8200
VAULT_TOKEN=trustlens-root-token
VAULT_SECRET_PATH=secret/data/trustlens
RA_SERVICE_URL=http://risk-analysis:9000
