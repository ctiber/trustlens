# cl-v3 — s=(1,1,1,1,1) full posture, same closed-loop infrastructure (Static-V3 baseline)
# Closed-loop infrastructure: Kafka mTLS always on (cannot be hot-switched),
# gateway→service mTLS switchable (dual connectors + nginx reload), Vault and
# risk-analysis always running; p2/p5 switchable via /zt/posture.
ZT_AC4A=true
ZT_MTLS=true
ZT_MTLS_MODE=on
ZT_HTTP_MTLS_MODE=dual
ZT_GATEWAY_CONF=active.conf
ZT_SR=true
ZT_SR_LEVEL=1.0
ZT_SR_BASE_PERIOD_S=60
ZT_RA=true
ZT_RA_LEVEL=1.0
# Observation floor (TrustLens deployment): p2 and a 10% sample of p5 run in
# shadow mode whenever they are not enforced; their would-be denials feed R_sec.
ZT_AC4A_SHADOW=true
ZT_RA_SHADOW_LEVEL=0.1
ZT_PROFILES=sr,ra

VAULT_ADDR=http://vault:8200
VAULT_TOKEN=trustlens-root-token
VAULT_SECRET_PATH=secret/data/trustlens
RA_SERVICE_URL=http://risk-analysis:9000
