# Build artifacts
testbed/*/target/
gatling/target/

# Python
framework/.venv/
framework/__pycache__/
**/__pycache__/
*.pyc

# Generated certificates (run scripts/01_gen_certs.sh to recreate)
testbed/certs/
testbed/certs-zt/

# Node dependencies of the risk-analysis service (npm install, see 00_build.sh)
testbed/risk-analysis/node_modules/

# Gateway configuration rewritten at runtime by the closed-loop controller
testbed/gateway/active.conf

# Raw Gatling reports (several GB). Their figures are summarised in
# results_zt/analysis.json.
# Runtime outputs generated by scripts — ignored so re-runs don't pollute the repo.
# The paper's pre-computed versions in results/ are tracked via explicit git add.
results/history_*.csv
results/*.log
results/gatling/

# Editor artefacts
*.~
.DS_Store
